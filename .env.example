NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mercado Livre (somente servidor; cadastrar na Vercel, sem NEXT_PUBLIC_)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google AI Studio (somente servidor)
GEMINI_API_KEY=

# Google Cloud Vision (busca por imagem; somente servidor)
GOOGLE_VISION_API_KEY=
# desligada por padrão; defina true para usar
GOOGLE_VISION_ENABLED=

# Busca por imagem (Google Lens via SerpApi). Opcional: sem a chave, essa etapa fica desligada.
SERPAPI_KEY=

# Supabase: chave secreta (somente servidor; Settings > API Keys > Secret keys). Usada pela fila em segundo plano.
SUPABASE_SECRET_KEY=

# Servidor de remoção de fundo (Hugging Face Space, pasta hf-space/). Opcional: sem ele o fundo é removido no navegador.
FUNDO_URL=
FUNDO_TOKEN=
